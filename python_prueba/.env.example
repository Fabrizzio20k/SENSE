# Copiar a .env: el backend lo carga automáticamente desde python_prueba/.env.
# Las variables ya definidas en el sistema tienen prioridad; no contiene secretos.
SENSE_INPUT_MODE=live
SENSE_MQTT_HOST=127.0.0.1
SENSE_MQTT_PORT=1883
# Opcionales: sin estas rutas, usa SENSE_DATA_DIR/models (data/models por defecto).
# Reutiliza una exportación válida o la genera antes del experimento si falta.
# SENSE_VISION_MODEL=/ruta/a/yolo26n_320_ncnn_model
# SENSE_VISION_WEIGHTS=/ruta/a/yolo26n.pt
SENSE_VISION_INPUT_SIZE=320
SENSE_VISION_TILE_SIZE=0
SENSE_VISION_TILE_OVERLAP=160
# No hace falta configurarlos con run-litert.sh; estos ya son los valores internos.
# Solo se permiten destinos HTTP de loopback.
# SENSE_SLM_URL=http://127.0.0.1:8080
# SENSE_SLM_MODEL=gemma4-e2b
SENSE_SLM_IMAGE_SIDE=480
# Calentamiento con static/image.png al arrancar (activo por defecto). 0 para ensayos en frío.
# SENSE_SLM_WARMUP=1
# SENSE_SLM_PID=1234
# No habilitar estas declaraciones hasta verificar los relojes del hardware.
SENSE_CAMERA_CLOCK_IS_BOOTTIME=0
SENSE_RADAR_TIMESTAMP_IS_MEASUREMENT=0
# SENSE_RADAR_UNCERTAINTY_S=...
# SENSE_CAMERA_UNCERTAINTY_S=...
