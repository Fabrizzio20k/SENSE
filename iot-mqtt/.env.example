# Dirección del único broker que recibe datos de todas las Raspberry y sensores.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Identidad única de esta Raspberry Pi.
DEVICE_ID=rpi5-01
MQTT_CLIENT_ID=rustio-sensor-rpi5-01
# El receptor usa otra identidad para no desconectar al publicador.
MQTT_RECEIVER_CLIENT_ID=rustio-receiver-rpi5-01
MQTT_TOPIC_PREFIX=rustio/rpi5-01

# Frecuencia de adquisición y entrega. QoS 1 confirma la recepción por el broker.
MQTT_INTERVAL_SECONDS=2
MQTT_QOS=1

# Active TLS cuando el broker lo ofrezca (normalmente puerto 8883).
MQTT_TLS=false
MQTT_CA_CERT=

# Configuración del receptor. El + escucha la telemetría de cada dispositivo.
MQTT_TOPIC_FILTER=rustio/+/telemetry
# MQTT_OUTPUT_FILE=data/telemetry.ndjson
